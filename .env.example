# Database configuration
DB_NAME=darwin_database
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432

# Darwin kafka feed credentials
CONSUMER_USERNAME=your_kafka_username
CONSUMER_PASSWORD=your_kafka_password
